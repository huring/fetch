# Documentation only - this file is not read by the app. Set these as
# environment variables in your Portainer stack (or a local .env for
# docker-compose, which is gitignored).
#
# Per-marketplace settings (poll interval, request delay, and any auth a
# marketplace needs) are NOT here - they're admin-UI-editable at
# /marketplaces, stored in the database instead of env vars.

# --- Secrets ---
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_URL=

# --- Optional overrides (defaults shown) ---
DIGEST_TIME=08:00
SCORE_INSTANT_THRESHOLD=8
SCORE_DIGEST_MIN=5
HEALTH_ALERT_AFTER_N_FAILURES=3
CLAUDE_MODEL=claude-haiku-4-5
SCORING_BATCH_SIZE=25
MAX_PAGES_PER_QUERY=2
LOG_LEVEL=INFO
DRY_RUN=false
ADMIN_PORT=8000
DB_PATH=/data/watcher.db
