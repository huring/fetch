# Documentation only - this file is not read by the app. Set these as
# environment variables in your Portainer stack (or a local .env for
# docker-compose, which is gitignored).

# --- Secrets ---
ANTHROPIC_API_KEY=
TRADERA_APP_ID=
TRADERA_APP_KEY=
SLACK_WEBHOOK_URL=

# --- Optional overrides (defaults shown) ---
POLL_INTERVAL_MINUTES=20
DIGEST_TIME=08:00
SCORE_INSTANT_THRESHOLD=8
SCORE_DIGEST_MIN=5
HEALTH_ALERT_AFTER_N_FAILURES=3
CLAUDE_MODEL=claude-haiku-4-5
SCORING_BATCH_SIZE=10
BLOCKET_REQUEST_DELAY_SECONDS=2
TRADERA_REQUEST_DELAY_SECONDS=2
MAX_PAGES_PER_QUERY=2
LOG_LEVEL=INFO
DRY_RUN=false
ADMIN_PORT=8000
DB_PATH=/data/watcher.db
